{
    "name": "units/hasher",
    "description": "Hashing unit - native digests, HMAC and timing-safe comparison, on the patterns/unit contract.",
    "type": "library",
    "keywords": [
        "hasher",
        "hash",
        "digest",
        "hmac",
        "checksum",
        "unit",
        "dna",
        "provenance"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "patterns/unit": "^1.0",
        "patterns/value-object": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Units\\Hasher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Units\\Hasher\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
